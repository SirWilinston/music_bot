# Token principal de tu bot de Discord (Obtenido en el Discord Developer Portal)
DISCORD_TOKEN=tu_token_de_discord_aqui

# Credenciales de Spotify (Obtenidas en el Spotify Developer Dashboard)
SPOTIPY_CLIENT_ID=tu_client_id_de_spotify_aqui
SPOTIPY_CLIENT_SECRET=tu_client_secret_de_spotify_aqui

# URL de tu monitor de Uptime Kuma (Opcional, déjalo en blanco si no lo usas)
UPTIME_KUMA=https://tu-dominio-uptime-kuma.com/api/push/tu_codigo_aqui